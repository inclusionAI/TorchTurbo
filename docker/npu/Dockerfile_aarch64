# Use the CANN 9.0.0 runtime for Ascend A3 on openEuler with Python 3.11.
FROM quay.io/ascend/cann:9.0.0-a3-openeuler24.03-py3.11

# Install build tools, tmux, NFS utilities, ossutil, and installation dependencies.
RUN dnf install -y \
        ca-certificates \
        cmake \
        curl \
        gcc \
        gcc-c++ \
        git \
        make \
        nfs-utils \
        numactl-devel \
        openblas-devel \
        patch \
        tmux \
        unzip \
    && dnf clean all \
    && rm -rf /var/cache/dnf
RUN curl -fsSL https://gosspublic.alicdn.com/ossutil/install.sh \
        -o /tmp/install-ossutil.sh \
    && bash /tmp/install-ossutil.sh \
    && rm -f /tmp/install-ossutil.sh

# Use a public PyPI mirror for packages without an explicit index.
ARG PIP_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple
# Install Ascend NPU packages and configure custom operators.
RUN pip install triton==3.5.0
RUN pip install triton-ascend==3.2.2 --extra-index-url=https://triton-ascend.osinfra.cn/pypi/simple
COPY docker/npu/pkg/* /usr/local/package/
RUN pip install /usr/local/package/torch_npu-2.10.0.post2-cp311-cp311-manylinux_2_28_aarch64.whl
# Build fla-npu v26.9.1 for Ascend A3 at commit 36e67d2decea70745554f7aebf9a6a29e9168a91.
RUN bash -c "source /usr/local/Ascend/ascend-toolkit/set_env.sh \
    && git clone https://github.com/flashserve/flash-linear-attention-npu.git /tmp/flash-linear-attention-npu \
    && git -C /tmp/flash-linear-attention-npu checkout 36e67d2decea70745554f7aebf9a6a29e9168a91 \
    && cd /tmp/flash-linear-attention-npu \
    && python -m pip install --no-cache-dir 'setuptools>=70.1' wheel -r requirements.txt \
    && FLA_NPU_SOC=ascend910_93 python scripts/build_wheel.py \
    && python -m pip install --force-reinstall --no-cache-dir --no-deps dist/flash_linear_attention_npu_a3-*.whl \
    && rm -rf /tmp/flash-linear-attention-npu"
RUN pip install /usr/local/package/flash_linear_attention-0.6.0-py3-none-any.whl
# Disable mimalloc to avoid MADV_FREE reclaiming DMA-written pages.
# Patch PyTorch's AArch64 default so USE_MIMALLOC=OFF takes effect.
ARG MAX_JOBS=8
RUN git clone --branch v2.10.0 --depth 1 --recurse-submodules --shallow-submodules \
        https://github.com/pytorch/pytorch.git /tmp/pytorch \
    && cd /tmp/pytorch \
    && sed -i 's/if(WIN32 OR (CPU_AARCH64 AND NOT APPLE))/if(WIN32)/' CMakeLists.txt \
    && pip install -r requirements-build.txt wheel \
    && USE_CUDA=0 USE_ROCM=0 USE_MPS=0 USE_XPU=0 \
        USE_MIMALLOC=OFF BUILD_TEST=0 BLAS=OpenBLAS \
        PYTORCH_BUILD_VERSION=2.10.0+cpu.nomimalloc PYTORCH_BUILD_NUMBER=1 \
        python setup.py bdist_wheel \
    && pip install dist/torch-*.whl --force-reinstall --no-deps \
    && cd / \
    && rm -rf /tmp/pytorch
# Install other packages
RUN pip install py-spy==0.4.2

# Configure shell startup and SSH access.
RUN rm -f /etc/profile.d/system-info.sh /etc/motd
RUN sed -i \
        's#source /usr/local/Ascend/nnal/atb/set_env.sh$#source /usr/local/Ascend/nnal/atb/set_env.sh --cxx_abi=1#' \
        /etc/profile /root/.bashrc
RUN if [ -f /etc/ssh/sshd_config ]; then \
        sed -i '/^[[:space:]#]*PasswordAuthentication[[:space:]]/d' /etc/ssh/sshd_config && \
        echo 'PasswordAuthentication no' >> /etc/ssh/sshd_config; \
    fi
